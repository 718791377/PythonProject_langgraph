      "owner_level": "project",
      "status": "implemented",
      "prompt_reminders": [
        "docs_bilingual/governance/openspec_official_workflow_policy.md",
        "docs_bilingual/governance/openspec_official_workflow_policy.zh-CN.md"
      ],
      "script_controls": [
        "tools/verify_official_openspec.py",
        "tools/run_openspec_guard.py"
      ],
      "guard_steps": [
        "verify_official_openspec"
      ],
      "description": "Keeps official OpenSpec bootstrap, refresh, validation, and CI guard behavior executable."
    },
    {
      "id": "codex-skills-governance",
      "owner_level": "user",
      "status": "implemented",
      "prompt_reminders": [
        "docs_bilingual/governance/codex_user_level_skills_governance_policy.md",
