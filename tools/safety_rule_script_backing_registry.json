      "owner_level": "project",
      "status": "implemented",
      "prompt_reminders": [
        "AGENTS.md",
        "docs_bilingual/project_startup_summary.md",
        "docs_bilingual/project_startup_summary.zh-CN.md",
        "docs_bilingual/governance/codex_multi_session_worktree_isolation_policy.md",
        "docs_bilingual/governance/codex_multi_session_worktree_isolation_policy.zh-CN.md"
      ],
      "script_controls": [
        "tools/ci/local_gate.ps1",
        "tools/ci/local_mr_review.ps1",
        "tools/check_local_mirrored_ci_gate.py"
      ],
      "guard_steps": [
        "check_local_mirrored_ci_gate"
      ],
      "description": "Keeps repository publication local-first while requiring local and remote CI to share one gate script and requiring local MR review before remote MR publication."
    },
    {
      "id": "orchestration-activation-policy",
      "owner_level": "user",
      "status": "implemented",
      "prompt_reminders": [
        "AGENTS.md",
        "docs_bilingual/project_startup_summary.md",
        "docs_bilingual/project_startup_summary.zh-CN.md",
        "docs_bilingual/governance/codex_user_level_orchestration_activation_policy.md",
        "docs_bilingual/governance/codex_user_level_orchestration_activation_policy.zh-CN.md",
        "docs_bilingual/implementation_plans/automatic_orchestration_routing_enforcement_plan.md",
        "docs_bilingual/implementation_plans/automatic_orchestration_routing_enforcement_plan.zh-CN.md"
      ],
      "script_controls": [
        "tools/check_orchestration_activation_policy.py"
      ],
      "guard_steps": [
        "check_orchestration_activation_policy"
      ],
      "description": "Requires automatic orchestration activation traces, capability-chain state, timeout evidence labels, blocker reporting, durable-team thresholds, and existing-session retrofit to be backed by checker-enforced policy surfaces."
