{
  "schema_version": 1,
  "rules": [
    {
      "id": "context-retention-canary-surface",
      "owner_level": "project",
      "status": "implemented",
      "prompt_reminders": [
        "docs_bilingual/project_startup_summary.md",
        "docs_bilingual/project_startup_summary.zh-CN.md"
      ],
      "script_controls": [
        "tools/check_context_retention_canary_surface.py"
      ],
      "guard_steps": [
        "check_context_retention_canary_surface"
      ],
      "description": "Keeps the startup-summary canary project-owned, prevents duplicate literal prompt placement, and requires cold-start recovery to reread AGENTS.md."
    },
    {
      "id": "multi-session-worktree-isolation",
      "owner_level": "project",
      "status": "implemented",
      "prompt_reminders": [
        "docs_bilingual/governance/codex_multi_session_worktree_isolation_policy.md",
        "docs_bilingual/governance/codex_multi_session_worktree_isolation_policy.zh-CN.md"
      ],
      "script_controls": [
        "tools/check_worktree_session_hygiene.py"
      ],
      "guard_steps": [
        "check_worktree_session_hygiene"
      ],
      "description": "Prevents multi-session dirty worktree collisions, keeps the primary directory aligned with local main, and reports feature worktree release readiness separately from branch cleanup readiness."
    },
    {
      "id": "session-ownership-claims",
      "owner_level": "project",
      "status": "implemented",
      "prompt_reminders": [
        "docs_bilingual/governance/codex_multi_session_worktree_isolation_policy.md",
        "docs_bilingual/governance/codex_multi_session_worktree_isolation_policy.zh-CN.md"
