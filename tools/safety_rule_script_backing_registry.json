    {
      "id": "custom-agent-toml-schema",
      "owner_level": "user",
      "status": "implemented",
      "prompt_reminders": [
        "AGENTS.md",
        "docs_bilingual/governance/codex_user_level_orchestration_activation_policy.md",
        "docs_bilingual/governance/codex_user_level_orchestration_activation_policy.zh-CN.md",
