      "script_controls": [
        "tools/check_session_ownership_claims.py"
      ],
      "guard_steps": [
        "check_session_ownership_claims"
      ],
      "description": "Prevents concurrent sessions from claiming the same OpenSpec change or overlapping hotspot path scopes."
    },
    {
