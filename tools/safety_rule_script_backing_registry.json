      ],
      "script_controls": [
        "tools/check_codex_skills_governance.py"
      ],
      "guard_steps": [
        "check_codex_skills_governance"
      ],
      "description": "Keeps skill profile governance, cleanup safety, and browser-capability preservation backed by executable checks."
    },
    {
      "id": "name-clarity-rule",
      "owner_level": "project",
      "status": "implemented",
      "prompt_reminders": [
        "docs_bilingual/implementation_plans/general_template_phase0_update_patch_plan.md",
        "docs_bilingual/implementation_plans/general_template_phase0_update_patch_plan.zh-CN.md"
      ],
      "script_controls": [
        "tools/check_name_clarity_rules.py"
      ],
      "guard_steps": [
        "check_name_clarity_rules"
      ],
      "description": "Requires paths, commands, scripts, variables, and profile names to include a short explanation when listed."
    },
    {
