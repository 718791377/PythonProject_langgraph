from __future__ import annotations

import logging
import sys
from collections.abc import Sequence

from PySide6.QtWidgets import QApplication

from .main_window import MainWindow

LOGGER = logging.getLogger(__name__)


def build_app(argv: Sequence[str] | None = None) -> QApplication:
    """Create the QApplication without touching global project state."""
    app = QApplication(list(argv or []))
    app.setApplicationName("{{project_name}}")
    app.setOrganizationName("local-project")
    return app


def main(argv: Sequence[str] | None = None) -> int:
    """Run the visible GUI. Call only for explicit interactive verification."""
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(name)s: %(message)s")
    app = build_app(argv)
    window = MainWindow()
    window.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
