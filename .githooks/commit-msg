#!/bin/sh
set -eu

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

if command -v python >/dev/null 2>&1; then
  python tools/check_git_commit_language.py --root . --message-file "$1"
elif command -v python3 >/dev/null 2>&1; then
  python3 tools/check_git_commit_language.py --root . --message-file "$1"
elif command -v py >/dev/null 2>&1; then
  py -3 tools/check_git_commit_language.py --root . --message-file "$1"
else
  echo "Python was not found; cannot run Git commit language check." >&2
  exit 1
fi
